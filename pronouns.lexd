PATTERNS
Pronoun ([<erg>:] ([>:>] SpatialCase)?)? ([>:>] [<emph>:да])?
PronounObl [>:>] (((ClassMarker[-pl] | [<h><pl>:б] | [<n><pl>:р]) [<gen>:]) | CaseMarker[-erg,-gen]) ([>:>] SpatialCase)? ([>:>] [<emph>:да])?
PronounObl [>:>] SpatialCase ([>:>] [<emph>:да])?

(([жи<PRON>:жи] [>:>] ClassMarker) | [жи<PRON><pl>:жал]) ([>:>] [<emph>:да])?
[жи<PRON><obl>:ин] [>:>] [<obl>:] ([<m><erg>:що] | (([<f>:] | [<n>:]) [<erg>:лълъе]) | [<pl><erg>:до]) ([>:>] SpatialCase)? ([>:>] [<emph>:да])?
[жи<PRON><obl>:ин] [>:>] (OblMarker[m] | [<obl><pl>:ду]) ([<gen>:] | ([>:>] [<gen>:б])) ([>:>] SpatialCase)? ([>:>] [<emph>:да])?
[жи<PRON><obl>:ин] [>:>] OblMarker[-m,-hpl,-npl] [>:>] CaseMarker[gen] ([>:>] SpatialCase)? ([>:>] [<emph>:да])?
[жи<PRON><obl>:ин] [>:>] (OblMarker[-hpl,-npl] | [<obl><pl>:ду]) [>:>] CaseMarker[dat] ([>:>] SpatialCase)?
[жи<PRON><obl>:ин] [>:>] (OblMarker[-hpl,-npl] | [<obl><pl>:ду]) [>:>] [<dat><emph>:тта]
[жи<PRON><obl>:ин] [>:>] (OblMarker[-hpl,-npl] | [<obl><pl>:ду]) [>:>] CaseMarker[dat] [>:>] SpatialCase [>:>] [<emph>:да]
[жи<PRON><obl>:ин] [>:>] (OblMarker[-hpl,-npl] | [<obl><pl>:ду]) [>:>] CaseMarker[aff] ([>:>] SpatialCase)? ([>:>] [<emph>:да])?
[жи<PRON><obl>:ин] [>:>] (OblMarker[-hpl,-npl] | [<obl><pl>:ду]) [>:>] SpatialCase ([>:>] [<emph>:да])?

IntPronoun[com] [>:>] ClassMarker[-pl] ([>:>] (([<quest>:] ([:у] | [:да])) | [<indef>:дала]))?
IntPronoun[com] [>:>] ClassMarker[-pl] ([:>у] | [:>и]) ([>:>] (([<quest>:] ([:ву] | [:в] | [:да])) | [<indef>:дала]))?
IntPronoun[com] ClassMarker[pl] ([>:>] (([<quest>:] ([:у] | [:да])) | [<indef>:дала]))?
IntPronoun[pers] ([<erg>:] | ([>:>] CaseMarker[-erg,-gen])) ([>:>] SpatialCase)? ([>:>] (([<quest>:] ([:ву] | [:в] | [:да])) | [<indef>:дала]))?
IntPronoun[pers] [>:>] ([<m>:ву] | [<f>:йиву] | [<n>:бу] | [<h><pl>:бу] | [<n><pl>:риву]) [<gen><quest>:]
IntPronoun[pers] [>:>] (ClassMarker[-pl] | [<h><pl>:б] | [<n><pl>:р]) [<gen>:] ([>:>] ([<quest>:да] | [<indef>:дала]))?
IntPronoun[pers] [>:>] (ClassMarker[-pl] | [<h><pl>:б] | [<n><pl>:р]) [<gen>:] [>:>] SpatialCase ([>:>] (([<quest>:] ([:ву] | [:в] | [:да])) | [<indef>:дала]))?
IntPronoun[com] [>:>] (ClassMarker[pl] | (OblMarker[-m,-f,-n] [>:>] CaseMarker ([>:>] SpatialCase)?)) ([>:>] (([<quest>:] ([:ву] | [:в] | [:да])) | [<indef>:дала]))?
(IntPronoun[n] | (IntPronoun[com] OblMarker[-m,-f,-n])) [>:>] CaseMarker ([>:>] SpatialCase)? ([>:>] (([<quest>:] ([:ву] | [:в] | [:да])) | [<indef>:дала]))?
(IntPronoun[-com,-adj,-st] | (IntPronoun[com] [>:>] OblMarker[-m,-f,-n])) [>:>] SpatialCase ([>:>] (([<quest>:] ([:ву] | [:в] | [:да])) | [<indef>:дала]))?

(IntPronoun[adj] | IntPronoun[st]) ([>:>] [<quest>:] ([:ву] | [:в] | [:да]))?
IntPronoun[adj] [>:>] (([<obl>:] ([<m>:щ] | [<f>:т] | [<n>:т]) [>:>] [<erg>:ти]) | (OblMarker[-m,-f,-n] [>:>] CaseMarker[erg])) ([>:>] SpatialCase)? ([>:>] [<quest>:] ([:ву] | [:в] | [:да]))?
IntPronoun[adj] [>:>] OblMarker[-f,-n,-npl] ([<gen>:] | ([>:>] [<gen>:б])) ([>:>] SpatialCase)? ([>:>] [<quest>:] ([:ву] | [:в] | [:да]))?
IntPronoun[adj] [>:>] OblMarker[-m,-hpl] [>:>] CaseMarker[gen] ([>:>] SpatialCase)? ([>:>] [<quest>:] ([:ву] | [:в] | [:да]))?
IntPronoun[adj] [>:>] OblMarker [>:>] CaseMarker[-erg,-gen] ([>:>] SpatialCase)? ([>:>] [<quest>:] ([:ву] | [:в] | [:да]))?
IntPronoun[st] ([>:>] ([<obl><n>><erg>:т>ти] | (OblMarker[n] [>:>] CaseMarker[-erg])))? ([>:>] SpatialCase)? ([>:>] [<quest>:] ([:ву] | [:в] | [:да]))?
((IntPronoun[adj] [>:>] OblMarker) | (IntPronoun[st] [>:>] OblMarker[n])) [>:>] SpatialCase ([>:>] [<quest>:] ([:ву] | [:в] | [:да]))?

DemPronoun [>:>] ClassMarker
[бокьара<PRON>:бокьара] [>:>] (ClassMarker[-pl] | [<h><pl>:б] | [<n><pl>:р])
(DemPronoun | [бокьара<PRON>:бокьара]) [>:>] (([<obl>:] ([<m>:щ] | [<f>:т] | [<n>:т]) [>:>] [<erg>:ти]) | (OblMarker[-m,-f,-n] [>:>] CaseMarker[erg])) ([>:>] SpatialCase)?
(DemPronoun | [бокьара<PRON>:бокьара]) [>:>] OblMarker[-f,-n,-npl] ([<gen>:] | ([>:>] [<gen>:б])) ([>:>] SpatialCase)?
